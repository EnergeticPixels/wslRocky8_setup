GIT_NAME="Elmer Humperdink"
GIT_EMAIL="developer@somewhere.us"
GPG_EXPIRATION=1y
SSH_KEY_EXPIRATION=1y
WEB_SERVER=apache
# Web SSL Configuration
# WEB_SSL_ENABLE=true enables HTTPS provisioning behavior for the selected web server.
# SSL execution is implemented for both Apache and NGINX.
WEB_SSL_ENABLE=false
# Base developer URL for cert generation. Must end in .local and must not use wildcard syntax.
WEB_SSL_BASE_DOMAIN=app.local
# Certificate validity is fixed to 1 year for this phase.
WEB_SSL_CERT_EXPIRY=1y
# NGINX only: force HTTP requests to redirect to HTTPS when SSL is enabled.
WEB_SSL_FORCE_HTTPS_REDIRECT=true
PHP_ENABLE=false
PHP_VERSION=7.4
PHP_EXTENSIONS_BASELINE=common
PHP_EXTENSIONS_EXTRA=
PHP_EXTENSIONS_STRICT=true
# PHP database driver mode: auto (follows DATABASE_TYPE), mysql, postgres, none
PHP_DB_DRIVER_MODE=auto
JAVA_ENABLE=false
JAVA_VERSION=8
JAVA_SERVER_MODE=tomcat
JAVA_DISTRO=temurin
JAVA_APP_JAR_PATH=
JAVA_APP_PORT=8081
JAVA_APP_ARGS=
NODE_ENABLE=false
NODE_DEFAULT_VERSION=22
NODE_VERSIONS=22
NODE_NVM_VERSION=v0.40.3
NODE_GLOBAL_PACKAGES=

# Python Configuration
# PYTHON_ENABLE=true installs Python 3 base (python3, pip, venv, dev tools) + requests (always available)
# Optional features (only apply if PYTHON_ENABLE=true):
#   PYTHON_DATA_SCIENCE_STACK_ENABLE=true  : Install numpy and pandas
#   PYTHON_DEV_MODE (choose one):
#     - none    : Skip development frameworks
#     - flask   : Install Flask and pytest
#     - reflex  : Install Reflex and pytest (recommended for Python development)
#     - both    : Install both Flask and Reflex with pytest
#   PYTHON_VENV_PATH (optional):
#     - Path for provisioned Python virtual environment used for pip packages
#     - Default: $HOME/.venvs/initprov-python
PYTHON_ENABLE=false
PYTHON_DATA_SCIENCE_STACK_ENABLE=false
PYTHON_DEV_MODE=none

# Redis Cache Configuration
REDIS_ENABLE=false
REDIS_VERSION=7.0

# Database Configuration
# Choose which database to provision: mysql, postgres, mongodb, or none (default: none)
# WARNING: Passwords stored in plaintext in .env are for development/WSL only, NOT for production
DATABASE_TYPE=none
MARIADB_VERSION=10.5
POSTGRESQL_VERSION=17
MONGODB_VERSION=8.0

# Database Development Setup (used for mysql, postgres, and mongodb)
# Set DB_DEV_SETUP=true to automatically create a development database and user
DB_DEV_SETUP=false
DB_DEV_DB_NAME=dev_db
DB_DEV_USER=dev_user
DB_DEV_PASSWORD=dev_password
DB_DEV_USER_HOST=localhost
